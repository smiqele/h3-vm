  "contexts": {
    "version": "0.1.0",
    "model": {
      "user": {
        "description": "Пользователь платформы, который может администрировать Workspace и управлять Payment Account."
      },
      "workspace": {
        "description": "Контекст проектов и потребления облачных ресурсов, закреплённый за администратором.",
        "administeredBy": "user"
      },
      "project": {
        "description": "Обязательный организационный контекст ресурсов внутри Workspace, без собственного платёжного аккаунта и баланса.",
        "belongsTo": "workspace"
      },
      "resource": {
        "description": "Принадлежит одному Project; контекст Workspace определяется через этот Project.",
        "belongsTo": "project"
      }
    }
  },
  "resources": {
    "version": "0.3.0",
    "resources": [
      {
        "id": "resource.compute.vm",
        "name": "Виртуальная машина",
        "domain": "compute",
        "fields": [
          {
            "id": "id",
            "type": "string",
            "required": true
          },
          {
            "id": "name",
            "type": "string",
            "required": true
          },
          {
            "id": "status",
            "type": "enum",
            "values": [
              "creating",
              "running",
              "stopping",
              "stopped",
              "starting",
              "error",
              "deleting"
            ]
          },
          {
            "id": "network",
            "type": "string"
          },
          {
            "id": "subnetIp",
            "type": "string"
          },
          {
            "id": "publicIp",
            "type": "string",
            "nullable": true
          },
          {
            "id": "region",
            "type": "string",
            "required": true
          },
          {
            "id": "cpu",
            "type": "integer",
            "minimum": 1
          },
          {
            "id": "cpuUtilization",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "id": "ramGb",
            "type": "integer",
            "minimum": 1
          },
          {
            "id": "ramUtilization",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "id": "diskGb",
            "type": "integer",
            "minimum": 1
          },
          {
            "id": "diskLimitGb",
            "type": "integer",
            "minimum": 1
          },
          {
            "id": "image",
            "type": "string"
          }
        ],
        "operations": [
          {
            "id": "operation.compute.vm.create",
            "permission": "compute.vm.create"
          },
          {
            "id": "operation.compute.vm.start",
            "permission": "compute.vm.update"
          },
          {
            "id": "operation.compute.vm.stop",
            "permission": "compute.vm.update"
          },
          {
            "id": "operation.compute.vm.delete",
            "permission": "compute.vm.delete",
            "confirmation": "destructive"
          }
        ],
        "transitions": [
          {
            "from": "creating",
            "event": "provision-succeeded",
            "to": "running"
          },
          {
            "from": "creating",
            "event": "provision-failed",
            "to": "error"
          },
          {
            "from": "running",
            "event": "stop-requested",
            "to": "stopping"
          },
          {
            "from": "stopping",
            "event": "stop-succeeded",
            "to": "stopped"
          },
          {
            "from": "stopped",
            "event": "start-requested",
            "to": "starting"
          },
          {
            "from": "starting",
            "event": "start-succeeded",
            "to": "running"
          },
          {
            "from": [
              "running",
              "stopped",
              "error"
            ],
            "event": "delete-requested",
            "to": "deleting"
          }
        ]
      },
      {
        "id": "resource.database.cluster",
        "name": "Кластер базы данных",
        "domain": "database",
        "fields": [
          {
            "id": "id",
            "type": "string",
            "required": true
          },
          {
            "id": "name",
            "type": "string",
            "required": true
          },
          {
            "id": "status",
            "type": "enum",
            "values": [
              "creating",
              "running",
              "maintenance",
              "error",
              "deleting"
            ]
          },
          {
            "id": "engine",
            "type": "enum",
            "values": [
              "postgresql",
              "mysql"
            ]
          },
          {
            "id": "engineVersion",
            "type": "string",
            "required": true
          },
          {
            "id": "region",
            "type": "string",
            "required": true
          }
        ]
      }
    ]
  },
  "patterns": {
    "version": "0.3.0",
    "patterns": [
      {
        "id": "pattern.resource-list",
        "status": "prototype",
        "name": "Список ресурсов",
        "purpose": "Найти ресурс, оценить состояние и перейти к действию.",
        "components": [
          "component.page-header",
          "component.data-table"
        ],
        "requiredStates": [
          "loading",
          "empty",
          "populated",
          "error",
          "forbidden"
        ]
      },
      {
        "id": "pattern.resource-create",
        "status": "prototype",
        "name": "Создание ресурса",
        "purpose": "Собрать параметры, проверить ограничения и запустить долгую операцию.",
        "components": [
          "component.page-header",
          "component.form",
          "component.inline-alert"
        ],
        "requiredStates": [
          "ready",
          "submitting",
          "validation-error",
          "api-error",
          "quota-exceeded"
        ]
      },
      {
        "id": "pattern.error.field",
        "status": "prototype",
        "name": "Ошибка поля",
        "scope": "field",
        "recovery": "edit-input",
        "components": [
          "primitive.text-field"
        ]
      },
      {
        "id": "pattern.error.operation",
        "status": "prototype",
        "name": "Ошибка операции",
        "scope": "operation",
        "recovery": "retry-or-details",
        "components": [
          "component.inline-alert"
        ]
      },
      {
        "id": "pattern.error.quota",
        "status": "prototype",
        "name": "Превышение квоты",
        "scope": "constraint",
        "recovery": "change-request-or-request-quota",
        "components": [
          "component.inline-alert"
        ]
      },
      {
        "id": "pattern.vm-status-transition",
        "status": "prototype",
        "name": "Смена статуса виртуальной машины",
        "purpose": "Показать отдельно от экрана переход ресурса и доступность действий.",
        "resource": "resource.compute.vm",
        "variants": [
          {
            "from": "running",
            "intermediate": "stopping",
            "to": "stopped",
            "action": "operation.compute.vm.stop"
          },
          {
            "from": "stopped",
            "intermediate": "starting",
            "to": "running",
            "action": "operation.compute.vm.start"
          },
          {
            "from": "running",
            "intermediate": "deleting",
            "to": "deleted",
            "action": "operation.compute.vm.delete"
          },
          {
            "from": "creating",
            "intermediate": "creating",
            "to": "error",
            "action": "provision"
          }
        ],
        "components": [
          "primitive.status",
          "component.inline-alert"
        ]
      }
    ]
  },
  "journeys": {
    "version": "0.3.0",
    "journeys": [
      {
        "id": "cjm.compute.vm.first-create",
        "name": "Первая виртуальная машина",
        "actor": "Администратор Workspace",
        "goal": "Создать работающую ВМ для приложения",
        "stages": [
          {
            "id": "discover",
            "name": "Ориентация",
            "touchpoint": "screen.compute.vm.list",
            "userGoal": "Понять состояние ресурсов Workspace и найти создание ВМ",
            "questions": [
              "Хватает ли квоты?",
              "Есть ли уже подходящая ВМ?"
            ],
            "emotion": "neutral",
            "signals": [
              "resource-summary",
              "empty-state"
            ]
          },
          {
            "id": "configure",
            "name": "Настройка",
            "touchpoint": "screen.compute.vm.create",
            "userGoal": "Выбрать конфигурацию без превышения квоты",
            "questions": [
              "Какой размер выбрать?",
              "Сколько это будет стоить?"
            ],
            "emotion": "uncertain",
            "risks": [
              "quota-exceeded",
              "incompatible-configuration"
            ]
          },
          {
            "id": "wait",
            "name": "Развертывание",
            "touchpoint": "pattern.vm-status-transition",
            "userGoal": "Убедиться, что процесс идет и не требует действий",
            "questions": [
              "Сколько ждать?",
              "Можно ли уйти со страницы?"
            ],
            "emotion": "attentive",
            "signals": [
              "creating-status",
              "progress-explanation"
            ]
          },
          {
            "id": "verify",
            "name": "Проверка результата",
            "touchpoint": "screen.compute.vm.list",
            "userGoal": "Найти созданную ВМ и убедиться, что она работает",
            "questions": [
              "Как подключиться?",
              "Что делать при ошибке?"
            ],
            "emotion": "positive",
            "signals": [
              "running-status",
              "network-address"
            ]
          }
        ],
        "successMetrics": [
          "create-flow-completion",
          "time-to-running",
          "quota-error-rate"
        ]
      }
    ]
  },
