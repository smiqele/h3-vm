{
  "size": {
    "sm": { "$type": "number", "$value": "{core.size.16}" },
    "md": { "$type": "number", "$value": "{core.size.20}" }
  },
  "surface": {
    "default": { "$type": "color", "$value": { "light": "{semantic.surface.subtle}", "dark": "{semantic.surface.subtle}" } },
    "selected": { "$type": "color", "$value": { "light": "{semantic.surface.accent}", "dark": "{semantic.surface.accent}" } },
    "hover": { "$type": "color", "$value": { "light": "{semantic.state.hover}", "dark": "{semantic.state.hover}" } }
  },
  "border": {
    "width": { "$type": "number", "$value": 1 },
    "color": { "$type": "color", "$value": { "light": "{semantic.border.subtle}", "dark": "{semantic.border.subtle}" } },
    "invalidColor": { "$type": "color", "$value": { "light": "{semantic.status.danger}", "dark": "{semantic.status.danger}" } }
  },
  "content": {
    "selected": { "$type": "color", "$value": { "light": "{core.color.white}", "dark": "{core.color.white}" } }
  },
  "checkbox": {
    "radius": { "$type": "number", "$value": "{core.radius.sm}" },
    "markSize": {
      "sm": { "$type": "number", "$value": 14 },
      "md": { "$type": "number", "$value": 18 }
    },
    "indeterminate": {
      "width": {
        "sm": { "$type": "number", "$value": 8 },
        "md": { "$type": "number", "$value": 10 }
      },
      "height": { "$type": "number", "$value": 2 },
      "radius": { "$type": "number", "$value": 1 }
    }
  },
  "radio": {
    "radius": { "$type": "number", "$value": "{core.radius.full}" },
    "markSize": { "$type": "number", "$value": "{core.size.8}" }
  },
  "focus": {
    "ringWidth": { "$type": "number", "$value": 3 },
    "color": { "$type": "color", "$value": { "light": "{semantic.surface.accent}", "dark": "{semantic.surface.accent}" } },
    "opacity": { "$type": "string", "$value": "22%" }
  },
  "disabled": {
    "opacity": { "$type": "string", "$value": "0.4" }
  },
  "motion": {
    "duration": { "$type": "string", "$value": "120ms" }
  }
}
